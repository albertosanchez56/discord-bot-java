public class PlayCommand extends ListenerAdapter {
    private static final ScheduledExecutorService INACTIVITY_SCHEDULER = Executors.newSingleThreadScheduledExecutor();
    private ScheduledFuture<?> inactivityTask;

    @Override
    public void onMessageReceived(MessageReceivedEvent event) {
        MessageChannel textChannel = event.getChannel();
        String[] parts = event.getMessage().getContentRaw().split(" ", 2);
        if (!parts[0].equalsIgnoreCase("!play") || parts.length < 2) {
            return;
        }

        Member member = event.getMember();
        if (member == null || !member.getVoiceState().inAudioChannel()) {
            event.getChannel().sendMessage("¡Únete primero a un canal de voz!").queue();
            return;
        }

        AudioChannelUnion channel = member.getVoiceState().getChannel();
        if (channel == null) {
            event.getChannel().sendMessage("No pude determinar tu canal de voz.").queue();
            return;
        }

        var guild = event.getGuild();
        guild.getAudioManager().openAudioConnection(channel);

        long guildId = guild.getIdLong();
        GuildMusicManager musicManager = PlayerManager.getInstance().getGuildMusicManager(guildId);
        musicManager.scheduler.setDisconnectCallback(() -> {
            // 1) Desconecta el audio
            guild.getAudioManager().closeAudioConnection();
            // 2) Envía un mensaje de aviso
            textChannel.sendMessage("⏹️ Me desconecto por inactividad. ¡Hasta pronto!").queue();
        });
        guild.getAudioManager().setSendingHandler(new AudioPlayerSendHandler(musicManager.player));

        String rawUrl = parts[1];
        String cleanUrl = rawUrl.contains("&") ? rawUrl.substring(0, rawUrl.indexOf("&")) : rawUrl;

        BertiniBot.YTDLP_POOL.submit(() -> {
            try {
                event.getChannel().sendMessage("Obteniendo información con Youtube...").queue();
                String title = YtDlpManager.getVideoTitle(cleanUrl);
                String directUrl = YtDlpManager.getAudioUrl(cleanUrl);

                if (inactivityTask != null && !inactivityTask.isDone()) {
                        inactivityTask.cancel(false);
                    }


                if (title.toLowerCase().contains("roxanne")) {
                    event.getChannel()
                            .sendMessage("🚫 Lo siento, la canción **" + title + "** está bloqueada.")
                            .queue();
                    // Y justo después, el enlace al GIF
                    event.getChannel()
                            .sendMessage("https://tenor.com/view/aqui-no-hay-quien-viva-gif-14069994")
                            .queue();

                    inactivityTask = INACTIVITY_SCHEDULER.schedule(() -> {
                        guild.getAudioManager().closeAudioConnection();
                        textChannel.sendMessage("⏹️ Me desconecto por inactividad. ¡Hasta pronto!").queue();
                    }, 1, TimeUnit.MINUTES);
                    return;
                }

                final String trackTitle = title;

                // Encolar vía LavaPlayer
                PlayerManager.getInstance()
                        .getPlayerManager()
                        .loadItem(directUrl, new AudioLoadResultHandler() {
                            @Override
                            public void trackLoaded(AudioTrack track) {
                                if (inactivityTask != null && !inactivityTask.isDone()) {
                                    inactivityTask.cancel(false);
                                }

                                // Genera la URL de la thumbnail de YouTube
                                String thumbUrl = "https://img.youtube.com/vi/"
                                        + track.getIdentifier()
                                        + "/mqdefault.jpg";

                                // Encola con título y thumbnail
                                musicManager.scheduler.queue(track, trackTitle, thumbUrl);

                                // Ahora muestra la cola usando thumbnails (opción A)
                                mostrarColaConThumbnails(event, musicManager.scheduler);
                            }

                            @Override
                            public void playlistLoaded(AudioPlaylist playlist) {
                                if (inactivityTask != null && !inactivityTask.isDone()) {
                                    inactivityTask.cancel(false);
                                }

                                playlist.getTracks().forEach(t -> {
                                    String title = t.getInfo().title;
                                    String thumbUrl = "https://img.youtube.com/vi/" + t.getIdentifier()
                                            + "/mqdefault.jpg";
                                    musicManager.scheduler.queue(t, title, thumbUrl);
                                });
                                mostrarColaConThumbnails(event, musicManager.scheduler);
                            }

                            @Override
                            public void noMatches() {
                                event.getChannel().sendMessage("No se encontró ningún resultado para: " + cleanUrl)
                                        .queue();
                            }

                            @Override
                            public void loadFailed(FriendlyException exception) {
                                event.getChannel().sendMessage("Error al cargar la pista: " + exception.getMessage())
                                        .queue();
                            }
                        });

            } catch (Exception e) {
                event.getChannel().sendMessage("Error al procesar con yt-dlp: " + e.getMessage()).queue();
            }
        });
    }

    private void mostrarColaConThumbnails(MessageReceivedEvent event, AudioTrackScheduler scheduler) {
        // 1) Obtén la pista que está sonando ahora
        AudioTrack nowPlaying = scheduler.getPlayer().getPlayingTrack();
        String nowTitle = nowPlaying != null
                ? scheduler.getTitleMap().getOrDefault(nowPlaying, nowPlaying.getInfo().title)
                : "Ninguna";

        // 2) Miniatura de YouTube a partir del ID
        String thumbnailUrl = nowPlaying != null
                ? "https://img.youtube.com/vi/" + nowPlaying.getIdentifier() + "/mqdefault.jpg"
                : null;

        // 3) Lista los próximos tracks
        List<String> upcoming = scheduler.getQueueTitles();

        // 4) Construye el embed
        EmbedBuilder eb = new EmbedBuilder()
                .setTitle("🎶 Reproduciendo ahora: " + nowTitle)
                .setColor(new Color(0x1DB954)); // verde Spotify

        if (thumbnailUrl != null) {
            eb.setThumbnail(thumbnailUrl);
        }

        // 5) Descripción con las canciones siguientes
        if (!upcoming.isEmpty()) {
            StringBuilder desc = new StringBuilder("**Próximas en cola:**\n");
            for (int i = 0; i < upcoming.size(); i++) {
                desc.append(i + 1)
                        .append(". ")
                        .append(upcoming.get(i))
                        .append("\n");
            }
            eb.setDescription(desc.toString());
        } else {
            eb.setDescription("_La cola está vacía._");
        }

        // 6) Envía el embed
        event.getChannel().sendMessageEmbeds(eb.build()).queue();
    }

}


public class YtDlpService {
    /**
     * Obtiene el título, la URL directa de audio y el ID de YouTube.
     * Si el input es un enlace HTTP, extrae el ID de la propia URL;
     * si es una búsqueda (ytsearch1:), usa yt-dlp para obtener el ID.
     *
     * @param input URL directa o prefijo "ytsearch1:consulta".
     * @return TrackInfo con título, directUrl y videoId.
     * @throws Exception si falla la ejecución de yt-dlp.
     */
    public TrackInfo fetchTrackInfo(String input) throws Exception {
        // 1) Obtener título y URL de audio con yt-dlp
        String title     = YtDlpManager.getVideoTitle(input);
        String directUrl = YtDlpManager.getAudioUrl(input);

        // 2) Determinar ID de YouTube
        String videoId;
        if (input.startsWith("http://") || input.startsWith("https://")) {
            // Enlace directo: extraer del parámetro 'v' o último segmento
            videoId = extractVideoId(input);
        } else {
            // Búsqueda: usar yt-dlp --get-id
            videoId = YtDlpManager.getVideoId(input);
        }

        return new TrackInfo(title, directUrl, videoId);
    }

    /**
     * Extrae el parámetro 'v' o 'video_id' de la URL, o toma los últimos 11 caracteres.
     */
    private String extractVideoId(String url) {
        try {
            var uri = java.net.URI.create(url);
            var query = uri.getQuery();
            if (query != null) {
                for (var param : query.split("&")) {
                    var kv = param.split("=");
                    if (kv.length == 2 && (kv[0].equals("v") || kv[0].equals("video_id"))) {
                        return kv[1];
                    }
                }
            }
        } catch (Exception ignored) {}
        // Fallback: último segmento (hash length usual de YouTube)
        if (url.length() > 11) {
            return url.substring(url.length() - 11);
        }
        return null;
    }
}

private String extractVideoId(String url) {
        try {
            java.net.URI uri = java.net.URI.create(url);
            String query = uri.getQuery();
            if (query != null) {
                for (String param : query.split("&")) {
                    String[] kv = param.split("=");
                    if (kv.length == 2 && (kv[0].equals("v") || kv[0].equals("video_id"))) {
                        return kv[1];
                    }
                }
            }
        } catch (Exception ignored) {}
        // fallback: last path segment
        String[] parts = url.split("/v=");
        return parts.length > 1 ? parts[1].substring(0, 11) : null;
    }







    package com.main.util;

import com.main.audio.AudioTrackScheduler;
import com.sedmelluq.discord.lavaplayer.track.AudioTrack;
import net.dv8tion.jda.api.EmbedBuilder;
import net.dv8tion.jda.api.entities.MessageEmbed;
import net.dv8tion.jda.api.entities.User;

import java.awt.Color;
import java.time.Duration;
import java.time.Instant;
import java.time.ZoneOffset;
import java.time.format.DateTimeFormatter;
import java.util.List;

/**
 * Fabrica de embeds para Now Playing y Queue.
 */
public class EmbedFactory {
    /**
     * Genera un embed detallado de la pista en reproducción.
     * @param scheduler Scheduler con estado de reproducción
     * @param requester Usuario que solicitó la pista
     */
    public static MessageEmbed nowPlayingEmbed(AudioTrackScheduler scheduler, User requester) {
        AudioTrack now = scheduler.getPlayer().getPlayingTrack();
        String title = now != null
            ? scheduler.getTitleMap().getOrDefault(now, now.getInfo().title)
            : "_Nada reproduciéndose_";
        String author = now != null ? now.getInfo().author : "";
        long durationMs = now != null ? now.getDuration() : 0;

        // Obtener thumbnail almacenada en scheduler (incluye videoId)
        String thumbUrl = scheduler.getThumbMap().get(now);
        if (thumbUrl == null && now != null) {
            thumbUrl = "https://img.youtube.com/vi/" + now.getIdentifier() + "/hqdefault.jpg";
        }

        // Extraer videoId desde la URL de thumbnail
        String videoId = null;
        if (thumbUrl != null) {
            try {
                String[] parts = thumbUrl.split("/vi/");
                if (parts.length > 1) {
                    videoId = parts[1].split("/")[0];
                }
            } catch (Exception ignore) {
                videoId = null;
            }
        }

        EmbedBuilder eb = new EmbedBuilder()
            .setAuthor(
                "Reproduciendo en BertiniBot",
                videoId != null ? "https://youtu.be/" + videoId : null,
                "https://media4.giphy.com/media/v1.Y2lkPTc5MGI3NjExdDN5azNpdGtsb3ZtN29pbnE0M2x4YnkweGNmdHNxNnhwaXQ4NXduaCZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/j3gsT2RsH9K0w/giphy.gif"
            )
            .setTitle(title)
            .setDescription("**Artista:** " + author + "\n" +
                            "**Duración:** " + formatTime(durationMs))
            .setColor(new Color(0x1DB954))
            .setTimestamp(Instant.now())
            .setFooter("Pedido por " + requester.getName(), requester.getEffectiveAvatarUrl());

        if (thumbUrl != null) eb.setThumbnail(thumbUrl);
        return eb.build();
    }

    /**
     * Genera un embed de la cola de reproducción.
     */
    public static MessageEmbed queueEmbed(AudioTrackScheduler scheduler) {
    List<String> titles = scheduler.getQueueTitles();

    EmbedBuilder eb = new EmbedBuilder()
        .setTitle("🎶 Cola de reproducción")
        .setColor(new Color(0x6A0DAD));

    if (titles.isEmpty()) {
        eb.setDescription("_La cola está vacía._")
          .setFooter("Total: 0 pista(s)");
        return eb.build();
    }

    // Construir lista numerada en la descripción
    StringBuilder desc = new StringBuilder();
    for (int i = 0; i < titles.size(); i++) {
        desc.append("**")
            .append(i + 1)
            .append(".** ")
            .append(titles.get(i))
            .append("\n");
    }

    eb.setDescription(desc.toString())
      .setFooter("Total: " + titles.size() + " pista(s)");

    return eb.build();
}

    /**
     * Formatea milisegundos a HH:mm:ss o mm:ss.
     */
    private static String formatTime(long millis) {
        Duration d = Duration.ofMillis(millis);
        long hours = d.toHours();
        int minutes = d.toMinutesPart();
        int seconds = d.toSecondsPart();
        if (hours > 0) {
            return String.format("%d:%02d:%02d", hours, minutes, seconds);
        } else {
            return String.format("%02d:%02d", minutes, seconds);
        }
    }
}

